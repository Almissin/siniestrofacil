            "body": {
              "mode": "raw",
              "raw": "{\n  \"rut\": \"{{rutAleatorio}}\",\n  \"nombre\": \"Camila\",\n  \"apellido\": \"Rojas\",\n  \"email\": \"{{emailAleatorio}}\",\n  \"password\": \"Camila2026!\",\n  \"telefono\": \"+56912345678\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Math.floor(10000000 + Math.random() * 89999999);",
                  "pm.collectionVariables.set(\"rutAleatorio\", n + \"-\" + Math.floor(Math.random()*10));",
                  "pm.collectionVariables.set(\"emailAleatorio\", \"usuario\" + Date.now() + \"@prueba.cl\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const b = pm.response.json();",
                  "pm.test(\"Se crea siempre como ASEGURADO y activo\", () => { pm.expect(b.rol).to.eql(\"ASEGURADO\"); pm.expect(b.activo).to.eql(true); });",
                  "pm.test(\"No expone la contrasena\", () => pm.expect(b).to.not.have.property(\"password\"));"
                ]
              }
            }
          ]
        },
