  "item": [
    {
      "name": "1. Autenticacion",
      "item": [
        {
          "name": "Login ADMIN -> 200 + token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@siniestrofacil.cl\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const b = pm.response.json();",
                  "pm.test(\"Entrega token Bearer\", () => { pm.expect(b.token).to.be.a('string').and.not.empty; pm.expect(b.tipo).to.eql(\"Bearer\"); });",
                  "pm.test(\"Rol ADMIN y sin contrasena en la respuesta\", () => { pm.expect(b.usuario.rol).to.eql(\"ADMIN\"); pm.expect(b.usuario).to.not.have.property(\"password\"); });",
                  "pm.collectionVariables.set(\"adminToken\", b.token);",
                  "pm.collectionVariables.set(\"adminId\", b.usuario.id);"
                ]
              }
            }
          ]
        },
