                  "pm.test(\"Activo, sin cupos ocupados\", () => { pm.expect(b.activo).to.eql(true); pm.expect(b.cuposOcupados).to.eql(0); pm.expect(b.cuposDisponibles).to.eql(4); });",
                  "pm.test(\"Header Location\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.collectionVariables.set(\"nuevoTallerId\", b.id);"
                ]
              }
